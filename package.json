{
  "name": "belvedere",
  "version": "0.1.0",
  "description": "System inventory, visualization, and monitoring — class-based hardware/software/network modeling",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/library/resolveType.test.ts src/library/registry.test.ts src/instances/validateAttributes.test.ts src/api/errorHandler.test.ts",
    "test:integration": "tsx --test --test-concurrency=1 src/instances/assetRepository.integration.test.ts src/instances/relationshipRepository.integration.test.ts src/instances/assetService.integration.test.ts src/api/server.integration.test.ts src/api/networkTopology.integration.test.ts src/settings/librarySourceRepository.integration.test.ts src/views/savedViewRepository.integration.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.3",
    "fastify": "^5.1.0",
    "neo4j-driver": "^5.27.0",
    "yaml": "^2.6.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20.12.0"
  }
}
